{
  "name": "applypilot",
  "private": true,
  "type":"module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "dotenv -e .env -- pnpm --filter @applypilot/web dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter @applypilot/worker dev",
    "db:generate": "dotenv -e .env -- pnpm --filter @applypilot/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @applypilot/database migrate",
    "test":"dotenv -e .env -- pnpm --filter @applypilot/discovery test",
    "lint":"eslint .",
    "lint:fix":"eslint . --fix",
    "format":"prettier --write .",
    "format:check":"prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0"
  }
}